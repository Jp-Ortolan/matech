# ---------------------------------------------------------------------------
# VARIÁVEIS DE AMBIENTE · modelo
# ---------------------------------------------------------------------------
# Copie para swm_ervateira/.env e preencha com os valores da sua máquina.
# O .env real NUNCA vai para o repositório — ver .gitignore.

# Conexão com o PostgreSQL.
# Formato: postgresql://USUARIO:SENHA@ENDERECO:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/swm_ervateira?schema=public"

# Porta em que a API escuta
PORT=3000

# Chave que assina os tokens JWT.
# Em produção, um valor longo e aleatório, guardado fora do código.
# Quem tiver esta chave consegue forjar um token — trate como senha.
JWT_SECRET="troque-por-um-valor-longo-e-aleatorio"

# Quanto tempo o token vale depois do login
JWT_EXPIRA_EM="8h"
