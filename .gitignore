# Dependências e artefatos de build
node_modules/
swm_ervateira/web/dist/
matech_app/build/
matech_app/.dart_tool/

# Segredos e ambiente
.env
.env.local
*.env

# Fotos gravadas em disco pela API (dado de operação, não código)
swm_ervateira/uploads/

# Documentação de ferramentas copiada para dentro do projeto por
# assistentes de código. Não é do MATECH.
#
# O "**/" é necessário: um padrão que já contém barra é ancorado na pasta do
# .gitignore, e sem ele estas linhas só valeriam para a raiz.
**/.claude/skills/
**/.windsurf/skills/
**/.agents/

# Notas de contexto escritas para retomar conversa com assistente de código.
# Valem para o dia em que foram escritas, não para quem lê o repositório.
CONTEXTO_*.md

# Material da banca: roteiro de apresentação e PDFs gerados a partir dele.
# É entrega da faculdade, não do sistema.
Guia_apresentacao_*.md
MATECH_estudo.pdf
MATECH_guia_banca.pdf

# Anotação solta de análise
matech_app/analise.txt

# Arquivos removidos que aguardam exclusão manual, e backups de pasta
_to_delete/
**/_backup_*/
*.bak

# Scripts soltos de verificação pontual
swm_ervateira/verificar-*.js

# Sistema operacional
Thumbs.db
desktop.ini
.DS_Store
